	"nodes":[
		{"id":"2fe9f7b2daf31c1b","type":"group","ratio":1.7777777777777777,"x":-260,"y":5860,"width":802,"height":451,"label":"Large models"},
		{"id":"07015ba17c813aff","type":"group","ratio":1.7777777777777777,"x":-240,"y":-140,"width":761,"height":428,"label":"Early collaborative filtering"},
		{"id":"761a5a8391e31777","type":"group","ratio":1.7777777777777777,"x":-240,"y":360,"width":761,"height":428,"label":"Memory vs item"},
