filters:
  and:
    - file.inFolder("planner/survey")
    - file.ext == "md"
views:
  - type: table
    name: Table
    order:
      - file.name
      - file.tags
      - link
      - status
      - usability
    sort:
      - property: file.name
        direction: ASC
      - property: status
        direction: ASC
